# AEOS Control Panel — Environment Variables
# Copy this file to .env and fill in all values before running docker-compose up.
# Never commit .env to version control.

# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Full connection string used by services (asyncpg format)
DATABASE_URL=

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_PASSWORD=
# Full Redis URL used by services
REDIS_URL=

# ─────────────────────────────────────────────
# Celery (Workflow Engine)
# ─────────────────────────────────────────────
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────
# HS256 secret for JWT signing — use a long random string
JWT_SECRET=
# JWT expiry in seconds (default: 3600)
JWT_EXPIRY_SECONDS=

# ─────────────────────────────────────────────
# AI Model API Keys
# ─────────────────────────────────────────────
GEMINI_API_KEY=
FEATHERLESS_API_KEY=

# ─────────────────────────────────────────────
# AI Model Names
# ─────────────────────────────────────────────
GEMINI_MODEL_PLANNER=
GEMINI_MODEL_ANALYSIS=
GEMINI_MODEL_OPERATIONS=
GEMINI_MODEL_VALIDATION=
GEMINI_MODEL_GOVERNANCE=

FEATHERLESS_MODEL_COMPLIANCE=

# ─────────────────────────────────────────────
# External Services
# ─────────────────────────────────────────────
SPEECHMATICS_API_KEY=
SPEECHMATICS_API_URL=

# ─────────────────────────────────────────────
# Frontend (Next.js)
# ─────────────────────────────────────────────
# Public base URL for REST API calls from the browser
NEXT_PUBLIC_API_BASE_URL=
# Public WebSocket URL for live event stream
NEXT_PUBLIC_WS_URL=

# ─────────────────────────────────────────────
# Runtime Governance Thresholds
# ─────────────────────────────────────────────
# Risk score at or above which an Approval Gate is triggered (default: 7.0)
RISK_THRESHOLD_HIGH=
# Risk score at or above which a Circuit Breaker is activated (default: 9.0)
RISK_THRESHOLD_CRITICAL=
# Seconds allowed for policy hot-reload after a policy update (default: 10)
POLICY_RELOAD_TIMEOUT_SECONDS=
# Rolling window size for anomaly detection baseline (number of actions, default: 1000)
ANOMALY_BASELINE_WINDOW=

# ─────────────────────────────────────────────
# Incident Classification
# ─────────────────────────────────────────────
# Minimum confidence score for automatic severity assignment (default: 0.7)
CONFIDENCE_THRESHOLD=

# ─────────────────────────────────────────────
# Escalation Timeouts
# ─────────────────────────────────────────────
# Seconds before re-notifying operator on unanswered escalation (default: 300)
ESCALATION_TIMEOUT_SECONDS=
# Seconds before escalating to Tier 2 operator after second timeout (default: 600)
ESCALATION_TIER2_TIMEOUT_SECONDS=

# ─────────────────────────────────────────────
# Workflow Engine
# ─────────────────────────────────────────────
# Per-step execution timeout in seconds (default: 120)
STEP_EXECUTION_TIMEOUT_SECONDS=

# ─────────────────────────────────────────────
# Memory Agent
# ─────────────────────────────────────────────
# Maximum milliseconds for context query responses (default: 500)
MEMORY_CONTEXT_QUERY_TIMEOUT_MS=

# ─────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────
# Number of recent events buffered per workflow for WebSocket replay (default: 1000)
EVENT_BUFFER_SIZE=
# Minimum days to retain Execution Traces and Audit Trail entries (default: 90)
AUDIT_RETENTION_DAYS=
